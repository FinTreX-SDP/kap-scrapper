# Copy this file to .env and set the paths for your machine.

# Full path to the Tesseract OCR executable.
# Windows install: winget install UB-Mannheim.TesseractOCR
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Folder with the Tesseract language files. It must contain:
#   tur.traineddata  from https://github.com/tesseract-ocr/tessdata_best/raw/main/tur.traineddata
#   eng.traineddata and osd.traineddata, copied from the tessdata folder of the Tesseract install
TESSDATA_PREFIX=C:\path\to\kapscrapper\tessdata
